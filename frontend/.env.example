# FastAPI service - internal upstream only, read server-side by
# src/app/api/challenge-me/route.ts. The browser never calls this directly.
FASTAPI_URL=http://localhost:8000

# Postgres connection used by Drizzle (history persistence)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/nope_ai

# Public site URL - used for metadataBase, canonical/OG URLs, robots.txt and
# sitemap.xml. Falls back to http://localhost:3000 if unset.
NEXT_PUBLIC_SITE_URL=https://nopeai.rifqimfahmi.dev

# Plausible analytics script host, exposed to the browser via <script src>.
NEXT_PUBLIC_PLAUSIBLE_URL=https://your-plausible-host.example.com

# Cloudflare Turnstile - bot-check on /api/challenge-me (see route.ts). Only
# needed here if you run `pnpm dev` directly on the host instead of via
# `docker compose up` - the containerized dev flow already gets Cloudflare's
# always-pass test keys from docker-compose.yml. Swap for real ones (from
# https://dash.cloudflare.com -> Turnstile -> Add site) when testing against
# production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

