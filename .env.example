# Which provider the FastAPI service should use: huggingface | anthropic | openai
LLM_PROVIDER=huggingface

# HuggingFace (used when LLM_PROVIDER=huggingface)
HF_TOKEN=
HF_MODEL=deepseek-ai/DeepSeek-V3-0324

# Anthropic (used when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# OpenAI (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4

# Phoenix tracing (optional). Leave blank to disable tracing.
# docker-compose sets this to http://phoenix:4317 automatically for the fastapi container.
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:4317
PHOENIX_PROJECT_NAME=nope-ai-contrarian
