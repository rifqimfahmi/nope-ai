# Which provider the FastAPI service should use: huggingface | anthropic | openai
LLM_PROVIDER=huggingface

# HuggingFace (used when LLM_PROVIDER=huggingface)
HF_TOKEN=
HF_MODEL=deepseek-ai/DeepSeek-V3-0324

# Anthropic (used when LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# OpenAI (used when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4

# Phoenix tracing (optional). Leave blank to disable tracing.
# docker-compose sets this to http://phoenix:4317 automatically for the fastapi container.
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:4317
PHOENIX_PROJECT_NAME=nope-ai-contrarian

# Postgres (used by the frontend's Drizzle-backed challenge history)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=nope_ai

# Public site URL (prod only) - baked into the frontend image at build time
# as a Next.js build arg (see docker-compose.prod.yml). Drives robots.txt,
# sitemap.xml, and canonical/OG URLs; falls back to localhost if unset.
NEXT_PUBLIC_SITE_URL=https://nopeai.rifqimfahmi.dev

# Newt tunnel (prod only, --profile tunnel up -d newt newt-monitor)
NEWT_SECRET=
MONITOR_URL=

# Cloudflare Turnstile (prod only) - bot-check on /api/challenge-me, required
# by docker-compose.prod.yml. Create a widget at
# https://dash.cloudflare.com -> Turnstile -> Add site, with this domain as
# the hostname (the domain does not need to be on Cloudflare's DNS/proxy).
# Site key is baked into the frontend build as a Next.js build arg (see
# docker-compose.prod.yml); secret key is read server-side at request time.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
